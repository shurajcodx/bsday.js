{
  "name": "@bsday.js/core",
  "version": "1.2.0",
  "description": "Ultra-fast, zero-dependency Day.js-compatible dual-calendar (Bikram Sambat BS ↔ Gregorian AD) SDK with Nepali fiscal year, KYC age, and Panchang engine for JavaScript and TypeScript.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "author": "shurajcodx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shurajcodx/bsday.js.git"
  },
  "bugs": {
    "url": "https://github.com/shurajcodx/bsday.js/issues"
  },
  "homepage": "https://bsdayjs.vercel.app",
  "keywords": [
    "nepali-calendar",
    "bikram-sambat",
    "nepali-date",
    "nepali-date-converter",
    "nepali-datepicker",
    "bs-to-ad",
    "ad-to-bs",
    "bsday",
    "bsdayjs",
    "dayjs-nepali",
    "moment-nepali",
    "date-fns-nepali",
    "nepali-fiscal-year",
    "panchang",
    "tithi",
    "nepali-patro",
    "hamro-patro",
    "devanagari",
    "nepal",
    "bikram-samvat",
    "nepali",
    "calendar",
    "date",
    "date-converter",
    "kyc-age",
    "business-days",
    "typescript",
    "javascript"
  ]
}
