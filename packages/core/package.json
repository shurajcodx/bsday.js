{
  "name": "@bsday.js/core",
  "version": "0.1.0",
  "description": "Core BSDay dual-calendar date library",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --shims",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "author": "shurajcodx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shurajcodx/bsday.js.git"
  },
  "bugs": {
    "url": "https://github.com/shurajcodx/bsday.js/issues"
  },
  "homepage": "https://github.com/shurajcodx/bsday.js#readme",
  "keywords": [
    "nepali",
    "calendar",
    "bs",
    "ad",
    "bikram",
    "sambat",
    "date",
    "nepali-date",
    "panchang",
    "typescript",
    "javascript"
  ]
}
