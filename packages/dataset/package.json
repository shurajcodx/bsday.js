{
  "name": "@bsday.js/dataset",
  "version": "1.0.0",
  "description": "BSDay optional festival and panchang dataset",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./month-data": {
      "types": "./dist/monthData.d.ts",
      "import": "./dist/monthData.js",
      "require": "./dist/monthData.cjs"
    },
    "./panchang-engine": {
      "types": "./dist/panchang-engine.d.ts",
      "import": "./dist/panchang-engine.js",
      "require": "./dist/panchang-engine.cjs"
    }
  },
  "files": [
    "dist",
    "ephe"
  ],
  "scripts": {
    "build": "npm run generate:month-data && tsup src/index.ts src/monthData.ts src/panchang-engine.ts --format esm,cjs --dts --shims",
    "generate:month-data": "node scripts/reconstruct-bs-calendar.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:aggregate": "node scripts/build-aggregate-from-years.mjs",
    "recompute:all": "node scripts/recompute-all-dataset.mjs",
    "create:year": "node scripts/create-year-template.mjs",
    "prepublishOnly": "npm run build:aggregate && npm run build"
  },
  "dependencies": {
    "swisseph-v2": "1.0.4"
  },
  "devDependencies": {},
  "author": "shurajcodx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shurajcodx/bsday.js.git"
  },
  "bugs": {
    "url": "https://github.com/shurajcodx/bsday.js/issues"
  },
  "homepage": "https://github.com/shurajcodx/bsday.js#readme",
  "keywords": [
    "nepali",
    "calendar",
    "bs",
    "ad",
    "bikram",
    "sambat",
    "date",
    "nepali-date",
    "panchang",
    "typescript",
    "javascript"
  ]
}