{
  "name": "@bsday.js/dataset",
  "version": "1.2.0",
  "description": "111-year astronomical Vedic Panchang (Tithi, Nakshatra, Yoga, Karana), Nepali festivals, and government public holidays dataset (1990–2100 BS / 40,543 days) for bsday.js.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./dist/all.d.ts",
        "default": "./dist/all.js"
      },
      "require": {
        "types": "./dist/all.d.cts",
        "default": "./dist/all.cjs"
      }
    },
    "./month-data": {
      "import": {
        "types": "./dist/monthData.d.ts",
        "default": "./dist/monthData.js"
      },
      "require": {
        "types": "./dist/monthData.d.cts",
        "default": "./dist/monthData.cjs"
      }
    },
    "./panchang-engine": {
      "import": {
        "types": "./dist/panchang-engine.d.ts",
        "default": "./dist/panchang-engine.js"
      },
      "require": {
        "types": "./dist/panchang-engine.d.cts",
        "default": "./dist/panchang-engine.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "all": [
        "./dist/all.d.ts"
      ],
      "month-data": [
        "./dist/monthData.d.ts"
      ],
      "panchang-engine": [
        "./dist/panchang-engine.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "ephe"
  ],
  "scripts": {
    "build": "node scripts/generate-month-data.mjs && tsup",
    "generate:month-data": "node scripts/generate-month-data.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:aggregate": "node scripts/build-aggregate-from-years.mjs",
    "recompute:all": "node scripts/recompute-all-dataset.mjs",
    "create:year": "node scripts/create-year-template.mjs",
    "prepublishOnly": "node scripts/build-aggregate-from-years.mjs && pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "swisseph-v2": "1.0.4"
  },
  "author": "shurajcodx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shurajcodx/bsday.js.git"
  },
  "bugs": {
    "url": "https://github.com/shurajcodx/bsday.js/issues"
  },
  "homepage": "https://bsdayjs.vercel.app",
  "keywords": [
    "nepali-calendar-dataset",
    "panchang",
    "tithi",
    "nakshatra",
    "yoga",
    "karana",
    "nepali-festivals",
    "nepali-holidays",
    "dashain",
    "tihar",
    "hamro-patro",
    "nepali-patro",
    "bikram-sambat",
    "nepali-date",
    "vedic-astrology",
    "panchangam",
    "bsday",
    "bsdayjs",
    "devanagari",
    "nepal",
    "astronomical-dataset",
    "typescript",
    "javascript"
  ]
}
