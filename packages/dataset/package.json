{
  "name": "@bsday/dataset",
  "version": "0.1.0",
  "description": "BSDay optional festival and panchang dataset",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:aggregate": "node scripts/build-aggregate-from-years.mjs",
    "recompute:all": "node scripts/recompute-all-dataset.mjs",
    "create:year": "node scripts/create-year-template.mjs",
    "prepublishOnly": "npm run build:aggregate && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "swisseph-v2": "1.0.4"
  }
}