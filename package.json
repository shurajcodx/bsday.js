{
  "name": "bsday.js",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node benchmarks/benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "globals": "^16.4.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "A comprehensive dual-calendar BS/AD date library for JavaScript/TypeScript with panchang data",
  "author": "shurajcodx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shurajcodx/bsday.js.git"
  },
  "bugs": {
    "url": "https://github.com/shurajcodx/bsday.js/issues"
  },
  "homepage": "https://github.com/shurajcodx/bsday.js#readme",
  "keywords": [
    "nepali",
    "calendar",
    "bs",
    "ad",
    "bikram",
    "sambat",
